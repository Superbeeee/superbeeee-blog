{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "superbeeee-blog",
  "main": "src/worker.js",
  "compatibility_date": "2026-05-03",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "AI_TRAFFIC_DB",
      "database_name": "ai_traffic",
      "database_id": "b5fe9fec-3351-42bd-aed1-2ca7b942edae"
    }
  ]
}
