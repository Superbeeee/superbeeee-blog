{# 自製極簡語言切換器：中 / EN / 日
   用 translation_entries_with_fallback helper 拿到當前頁的翻譯版本
   若該頁沒翻譯，會自動 fallback 到該語言的首頁 #}
{%- set entries = translation_entries_with_fallback(page) %}
{%- if entries and entries.length > 1 %}
<div class="lang-switcher">
  {%- for entry in entries %}
    {%- set label = '中' if entry.lang === 'zh-TW' else ('EN' if entry.lang === 'en' else '日') %}
    {%- if entry.isCurrent %}
      <span class="lang-current" lang="{{ entry.lang }}">{{ label }}</span>
    {%- else %}
      <a class="lang-link" href="{{ url_for(entry.path) }}" lang="{{ entry.lang }}"{% if entry.isFallback %} title="{{ entry.lang }} translation not yet available - opens homepage"{% endif %}>{{ label }}</a>
    {%- endif %}
    {%- if not loop.last %}<span class="lang-sep">/</span>{%- endif %}
  {%- endfor %}
</div>
{%- endif %}
