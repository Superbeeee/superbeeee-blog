// 語言切換器 - tigercosmos 風格
// 用 NeXT 的 CSS 變數，讓 light/dark mode 自動切換顏色
// position: absolute 讓它釘在 document 右上而不是 viewport，滾下去就消失，不會擋 sidebar
.lang-switcher
  position: absolute
  top: 18px
  right: 24px
  display: flex
  align-items: center
  gap: 8px
  font-family: Inter, -apple-system, BlinkMacSystemFont, sans-serif
  font-size: 13px
  letter-spacing: 0.3px
  padding: 6px 10px
  background: var(--content-bg-color)
  border: 1px solid var(--btn-default-border-color)
  border-radius: 4px
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08)

  .lang-current
    color: var(--link-hover-color)
    font-weight: 600
    border-bottom: 1px solid var(--link-hover-color)
    padding-bottom: 1px

  .lang-link
    color: var(--link-color)
    text-decoration: none
    transition: color 0.15s ease
    border-bottom: none

    &:hover
      color: var(--link-hover-color)
      border-bottom: none

  .lang-sep
    color: var(--btn-default-border-color)
    user-select: none

// 手機版縮小避免擋到 NeXT 漢堡選單（在左側）
@media (max-width: 767px)
  .lang-switcher
    top: 12px
    right: 12px
    font-size: 12px
    padding: 4px 8px

// 文章頁面：標題下方的語言切換列（tigercosmos.xyz 風格）
.post-lang-info
  margin: 12px 0 24px
  font-family: Inter, -apple-system, BlinkMacSystemFont, sans-serif
  font-size: 14px
  letter-spacing: 0.2px
  color: var(--text-color)
  opacity: 0.75

  .post-lang-label
    margin-right: 6px
    font-weight: 600

  .post-lang-current
    color: var(--link-hover-color)
    font-weight: 600
    border-bottom: 1px solid var(--link-hover-color)
    padding-bottom: 1px
    margin: 0 2px

  .post-lang-link
    color: var(--link-color)
    text-decoration: none
    border-bottom: none
    margin: 0 2px
    transition: color 0.15s ease

    &:hover
      color: var(--link-hover-color)
      border-bottom: none

  .post-lang-sep
    color: var(--text-color)
    opacity: 0.5
    user-select: none

  .post-lang-note
    margin-left: 8px
    font-size: 13px
    font-style: italic
    opacity: 0.7

@media (max-width: 767px)
  .post-lang-info
    font-size: 13px

    .post-lang-note
      display: block
      margin-left: 0
      margin-top: 4px
      font-size: 12px
